PORT=3000
MONGO_URI=mongodb://localhost:27017/cefet
JWT_SECRET=sua_chave_secreta_jwt_aqui_troque_em_producao
JWT_REFRESH_SECRET=sua_chave_refresh_secreta_aqui_troque_em_producao
# Access token curto (renovado automaticamente pelo refresh)
JWT_EXPIRES_IN=15m
# Refresh com "Lembrar-me" marcado (persistente)
JWT_REFRESH_EXPIRES_IN=30d
# Refresh sem "Lembrar-me" (sessão — apagado ao fechar o navegador)
JWT_REFRESH_SESSION_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
# Configuração de E-mail
# Desenvolvimento: use Mailtrap (https://mailtrap.io) — gratuito
# Produção: substitua pelas credenciais do seu provedor SMTP real
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=USUÁRIO_MAILTRAP_AQUI
MAIL_PASS=SENHA_MAILTRAP_AQUI
MAIL_FROM="CEFET/RJ <noreply@cefetrj.edu.br>"
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=sua_api_secret